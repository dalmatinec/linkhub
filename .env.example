# Токен от @BotFather
BOT_TOKEN=
# Твой Telegram ID (узнать: @userinfobot). Несколько через запятую
OWNER_IDS=

# Нейросеть. Пусто в AI_API_KEY = бот работает только на фразах из базы
AI_API_KEY=
# Цены модели, $ за 1 млн токенов, только для подсчёта расхода. По умолчанию DeepSeek Flash в обычные часы,
# в часы пика (PEAK_HOURS_UTC, пн-пт) всё умножается на PRICE_PEAK_X. Сверь с platform.deepseek.com → Pricing
PRICE_IN=0.15
PRICE_OUT=0.60
PRICE_CACHE=0.003
PRICE_PEAK_X=2
PEAK_HOURS_UTC=1-4,6-10
# Сколько $ можно потратить в сутки на все чаты. Кончилось: бот до полуночи отвечает фразами
DAILY_LIMIT_USD=0.20

# Сколько последних сообщений чата видит нейросеть
CONTEXT_MESSAGES=20
# Через сколько сообщений человека обновлять заметки о нём (0 = выключить)
MEMORY_EVERY=50
MEMORY_FIRST=20

# Настройки для новых чатов (потом меняются в /admin)
# имя бота в новых чатах; пусто = имя из профиля бота в Telegram
DEFAULT_NAME=
DEFAULT_CHANCE=0.04
DEFAULT_AI_SHARE=0.30
DEFAULT_COOLDOWN=90

TZ_NAME=Asia/Almaty
DATA_DIR=data
LOG_LEVEL=INFO

# ---------- Оплата рекламы в USDT: сеть TON и/или TRON (TRC20) ----------
# Адрес кошелька для приёма (UQ... или EQ...). Пусто: заказчикам пишет поддержка, оплату отмечаешь вручную
PAY_TON_ADDRESS=
# Бесплатный ключ toncenter (бот @tonapibot): без ключа 1 запрос в секунду, этого тоже хватает
TONCENTER_API_KEY=
# Адрес USDT TRC20 (начинается на T). Пусто: TRON не принимаем
PAY_TRON_ADDRESS=
# Бесплатный ключ TronGrid (trongrid.io), можно пусто
TRONGRID_API_KEY=
# Канал для формата «закреп в канале» (бот админ с правом закреплять), например -1001234567890
AD_CHANNEL_ID=
# Сколько часов ждать одобрения нового чата, потом бот сам выходит
APPROVAL_HOURS=24
# Пробный период в днях (кнопка в заявке)
TRIAL_DAYS=3
# Создатель бота: бот его хвалит и советует заказывать у него проекты. Узнаёт ТОЛЬКО по ID из OWNER_IDS
# (или CREATOR_IDS), не по имени. CREATOR=0 выключает
CREATOR=1
# Как бот тебя называет (можно пусто) и контакт для заказа проектов, например @username
CREATOR_NAME=
CREATOR_CONTACT=
# Закрытый канал для ежедневного бэкапа (id вида -100...). Бот должен быть там админом
BACKUP_CHANNEL=

# ---------- Связь с модератором (dalmatinec/baxi-guard), оба API только на 127.0.0.1 ----------
# Проще всего: bash /opt/linkhub/deploy/guard-link.sh (сам пропишет ключ в оба .env и перезапустит ботов)
# Общий ключ, одинаковый в .env Бакси и модератора. Пусто: API Бакси выключен, к модератору не ходим
BAXI_API_KEY=
BAXI_API_PORT=8710
GUARD_API_URL=http://127.0.0.1:8711
