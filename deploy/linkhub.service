# Сервис systemd для бота. Установка — см. README, раздел «Сервер (systemd)».
[Unit]
Description=linkhub catalog bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linkhub
Group=linkhub
WorkingDirectory=/opt/linkhub
ExecStart=/opt/linkhub/.venv/bin/python -m bot
Restart=always
RestartSec=5
# при остановке бот сам сохраняет буферы и закрывает базу
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

# защита: бот пишет только в свою папку data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/linkhub/data
MemoryMax=400M

[Install]
WantedBy=multi-user.target
